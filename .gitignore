# --- Item H41, 3 Oct 2026: secrets, data and noise - never committed ------
# Adopted from Civ's .gitignore (decision 102) for the new repository gpbm2026
# (Alan, Q8 and Q9 of 3 Oct 2026). An ignore rule has no effect on a file
# already tracked: this block was in place before the first commit.
#
# The .env above the document root holds the credentials
# (tools/env_loader.php reads it); .env.example lists its keys, no values.
.env
.env.*
!.env.example
creds/
# The per-host DaDaBIK configs that carry credentials. .local reads .env since
# H41; the .example is the tracked template. .server is credential-free.
public_html/dadabik/include/config_custom.php.local
# Database artefacts: some hold user data and password hashes.
sql_manual/
setup/*.sql
*.sql
*.sql.*
# Uploaded turn files are data (the database holds what was parsed), not source;
# error_logs/ is runtime output. Each keeps its deny .htaccess under git.
public_html/dadabik/uploads/*
!public_html/dadabik/uploads/.htaccess
public_html/dadabik/error_logs/*
!public_html/dadabik/error_logs/.htaccess
# Editor and tooling backups, and Claude's delivery folder.
*.bak-*
*.pre-*
Claude outputs/
